# ──────────────────────────────────────
# SignalHub APIs — Environment Variables
# ──────────────────────────────────────
# Copy to .env at the repo root (and/or apps/api/.env).
# Default local mode uses SQLite — no Docker required.

# Database (default: SQLite file in apps/api/)
DATABASE_URL=sqlite+aiosqlite:///./signalhub.db
DATABASE_URL_SYNC=sqlite:///./signalhub.db

# Optional Postgres (Docker Compose / production)
# DATABASE_URL=postgresql+asyncpg://signalhub:signalhub_dev@localhost:5432/signalhub
# DATABASE_URL_SYNC=postgresql://signalhub:signalhub_dev@localhost:5432/signalhub

# API
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Protect manual ingestion trigger (leave empty for open local demo)
TRIGGER_API_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
# Only needed if TRIGGER_API_KEY is set (exposed to browser — use demo keys only)
NEXT_PUBLIC_TRIGGER_API_KEY=

# Connectors (optional)
COINGECKO_API_KEY=

# Open-Meteo (fixed location for V1)
OPEN_METEO_LATITUDE=52.52
OPEN_METEO_LONGITUDE=13.41
